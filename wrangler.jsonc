// Cloudflare Workers (static assets) config for the SmartFlow Mini App frontend.
// Build command: npm run build:pages   Deploy command: npx wrangler deploy
// Build variable: SMARTFLOW_API_URL = Railway backend URL (https://...up.railway.app)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-project",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
