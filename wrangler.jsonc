// Cloudflare Workers (static assets) config for the SmartFlow Mini App frontend.
// Build command: npm run build:pages   Deploy command: npx wrangler deploy
// Build variable: SMARTFLOW_API_URL = Railway backend URL (https://...up.railway.app)
//
// The test copy (docs/STAGING.md): a second Worker "my-project-staging" built from the `staging` branch,
// deploy command `npx wrangler deploy --env staging`, SMARTFLOW_API_URL = the test Railway server.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-project",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "my-project-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
