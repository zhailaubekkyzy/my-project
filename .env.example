# SmartFlow Environment Configuration (Template)
PORT=3000
NODE_ENV=development

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Frontend origins allowed to call the API (comma-separated), e.g. Cloudflare Pages domain.
# Leave empty to allow any origin.
CORS_ORIGINS=

# JWT Secret for signing session tokens
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Database Configuration
# Supported drivers: 'sqlite' (local / testing) or 'postgres' (Supabase / Production)
DB_DRIVER=sqlite
DB_FILE=data/smartflow.db

# Supabase PostgreSQL Configuration
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Supabase: Connect → Connection string → "Session pooler" (works from Railway over IPv4)
# DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
# DB_DRIVER=postgres

# PostHog Analytics (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
