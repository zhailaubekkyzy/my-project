# SmartFlow Environment Configuration (Template)
PORT=3000
NODE_ENV=development

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Frontend origins allowed to call the API (comma-separated), e.g. Cloudflare Pages domain.
# Leave empty to allow any origin.
CORS_ORIGINS=

# JWT Secret for signing session tokens
JWT_SECRET=generate_a_random_32_character_secret_key_here

# Database Configuration
# Supported drivers: 'sqlite' (local / testing) or 'postgres' (Supabase / Production)
DB_DRIVER=sqlite
DB_FILE=data/smartflow.db

# Supabase PostgreSQL Configuration
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Supabase: Connect → Connection string → "Session pooler" (works from Railway over IPv4)
# DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
# DB_DRIVER=postgres

# PostHog Analytics (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Оплаты через платформу: Whop for Platforms (сначала только песочница). Ключи — только в Railway Variables.
# WHOP_ENV обязателен и пишется явно: sandbox (песочница) или production (боевой — только с решения владелицы).
# Без него оплаты не запускаются, продажи идут вручную (ссылка эксперта + чек). Ключи песочницы и боевого выглядят одинаково!
WHOP_ENV=
# Ключ API (Full access, песочница): в логи и ответы сервер его не пишет
WHOP_API_KEY=
# Секрет подписи вебхуков (Whop → Developer → Webhooks): вебхук без верной подписи получает 401
WHOP_WEBHOOK_SECRET=
# Аккаунт SmartFlow в Whop (biz_...)
WHOP_COMPANY_ID=
# Проценты — настройки (значения даёт владелица); пусто = не задано, такие продажи не создаются
PAYMENTS_PLATFORM_FEE_PERCENT=
PAYMENTS_MARKETER_FEE_PERCENT=
# Резерв для выплат маркетологу: 10% за 90 дней (по умолчанию)
# PAYMENTS_RESERVE_PERCENT=10
# PAYMENTS_RESERVE_DAYS=90
